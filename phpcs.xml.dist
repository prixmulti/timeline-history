<?xml version="1.0"?>
<ruleset name="Timeline History">
	<description>WordPress Coding Standards for the ArkivTimeline plugin.</description>

	<file>wordpress-plugin/timeline-history</file>

	<exclude-pattern>*/assets/dist/*</exclude-pattern>
	<exclude-pattern>*/blocks/timeline/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>

	<config name="minimum_supported_wp_version" value="6.4"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="timeline_history"/>
				<element value="Timeline_History"/>
				<element value="th_"/>
			</property>
		</properties>
	</rule>
</ruleset>