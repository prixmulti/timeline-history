{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "timeline-history/timeline",
  "title": "ArkivTimeline",
  "category": "widgets",
  "icon": "backup",
  "description": "Vis en tidslinje med dine historier.",
  "textdomain": "arkivtimeline",
  "attributes": {
    "layout": {
      "type": "string",
      "default": ""
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "skin": {
      "type": "string",
      "default": ""
    },
    "animation": {
      "type": "string",
      "default": ""
    },
    "category": {
      "type": "string",
      "default": ""
    },
    "timeline": {
      "type": "string",
      "default": ""
    },
    "limit": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "editorScript": "file:./build/index.js",
  "editorStyle": "file:./build/index.css",
  "render": "file:./render.php"
}
